# A copy of this file is your own: `cp .env.example .env` (0600), then fill in.
# Nothing here is ever committed; core never reads these — the commands do
# (ADRs 0024, 0025), and `agents-pod doctor --probe` asks the commands.

# Self-built app credentials: open platform → app → 凭证与基础信息.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Comma-separated chat_id allowlist; empty = every group chat the app is in.
# Read a chat_id from state.json's known_chats after one successful drain.
FEISHU_CHATS=

# 1 = only messages that @-mention the bot (a mixed-use group); 0 = everything.
FEISHU_REQUIRE_MENTION=0

# First-run window when there is no cursor yet, and the re-read overlap behind
# an existing one, in seconds.
FEISHU_LOOKBACK_SECONDS=3600
FEISHU_OVERLAP_SECONDS=60

# Per-pass item cap; the cursor stops at the last item printed, so a bigger
# burst simply arrives over several passes.
FEISHU_MAX_ITEMS=40
